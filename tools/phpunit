                    }
                }
            }
            // Backward pass.
            for ($k = -$d; $k <= $d; $k += 2) {
                /** @phpstan-ignore offsetAccess.notFound, offsetAccess.notFound */
                if ($k === -$d || $k !== $d && $vb[$offset + $k - 1] < $vb[$offset + $k + 1]) {
