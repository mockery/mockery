        $parameters = ['name' => $event->testSuite()->name(), 'message' => $event->message()];
        $parameters['duration'] = $this->duration($event);
        $this->writeMessage('testIgnored', $parameters);
        $this->writeMessage('testSuiteFinished', $parameters);
