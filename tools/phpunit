            if ($currentGit['isClean'] !== $referenceGit['isClean']) {
                throw new GitInformationMismatchException('isClean', $referenceGit['isClean'] ? 'true' : 'false', $currentGit['isClean'] ? 'true' : 'false');
            }
        }
    }
