    private ?CpuTime $testStartTotalCpuTime = null;
    /**
     * Accumulated wall-clock time of the failed attempts that preceded the
     * final attempt of a retried test. This is added to the time of the final
     * attempt so that the reported duration covers all attempts.
     */
    private ?Duration $retriedAttemptsDuration = null;
    /**
     * @var list<HRTime>
     */
    private array $suiteStartTimeStack = [];
    /**
     * @var list<CpuTime>
     */
    private array $suiteStartUserCpuTimeStack = [];
    /**
     * @var list<CpuTime>
     */
    private array $suiteStartSystemCpuTimeStack = [];
