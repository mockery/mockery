    public function __construct(int $expected)
    {
        $this->expectedCount = $expected;
    }
    public function toString(): string
    {
        return sprintf('count matches %d', $this->expectedCount);
    }
    /**
     * Returns the negated description when this constraint is wrapped in a
     * LogicalNot operator. The guard ensures that LogicalAnd, LogicalOr, and
     * LogicalXor keep using the affirmative toString().
     */
    protected function toStringInContext(\PHPUnit\Framework\Constraint\Operator $operator, mixed $role): string
    {
        if (!$operator instanceof \PHPUnit\Framework\Constraint\LogicalNot) {
            return '';
        }
        return sprintf('count does not match %d', $this->expectedCount);
    }
    /**
     * Evaluates the constraint for parameter $other. Returns true if the
     * constraint is met, false otherwise.
     *
     * @throws Exception
