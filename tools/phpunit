            case 'success':
                $testCSS = match ($testData['size']) {
                    'small' => ' class="covered-by-small-tests"',
                    'medium' => ' class="covered-by-medium-tests"',
                    // no break
                    default => ' class="covered-by-large-tests"',
                };
                break;
            case 'failure':
