            assert($metadata instanceof DependsOnMethod);
            if (empty($metadata->methodName())) {
                $dependencies[] = ExecutionOrderDependency::invalid();
                continue;
            }
            $dependencies[] = ExecutionOrderDependency::forMethod($metadata);
        }
        return $dependencies;
    }
