        $backupGlobalsExcludeList = [];
        $backupGlobalsMetadata = $this->methodOrClassLevelMetadata($metadataForMethod->isBackupGlobals(), $metadataForClass->isBackupGlobals());
        if ($backupGlobalsMetadata !== null) {
            assert($backupGlobalsMetadata instanceof BackupGlobals);
            if ($backupGlobalsMetadata->enabled()) {
                $backupGlobals = \true;
            }
