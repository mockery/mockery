final class RetryTestSuite extends \PHPUnit\Framework\IterativeTestSuite
{
    /**
     * @var positive-int
     */
    private int $maxAttempts = 1;
    /**
     * @var ?Closure(): TestCase
     */
    private ?Closure $additionalAttemptFactory = null;
    /**
     * @param non-empty-string       $name
     * @param positive-int           $maxAttempts
     * @param Closure(): TestCase    $additionalAttemptFactory
     * @param list<non-empty-string> $groups
     */
    public static function fromTestCase(string $name, \PHPUnit\Framework\TestCase $test, int $maxAttempts, Closure $additionalAttemptFactory, array $groups = []): self
    {
        $suite = self::empty($name);
        $suite->maxAttempts = $maxAttempts;
        $suite->additionalAttemptFactory = $additionalAttemptFactory;
        $suite->addTest($test, $groups);
        return $suite;
    }
