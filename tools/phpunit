final readonly class SystemCpuTimeMeter implements \PHPUnit\Event\Telemetry\CpuTimeMeter
{
    /**
     * @throws RuntimeException
     */
    public function userCpuTime(): \PHPUnit\Event\Telemetry\CpuTime
    {
        return $this->cpuTime('ru_utime.tv_sec', 'ru_utime.tv_usec');
    }
    /**
     * @throws RuntimeException
     */
    public function systemCpuTime(): \PHPUnit\Event\Telemetry\CpuTime
    {
        return $this->cpuTime('ru_stime.tv_sec', 'ru_stime.tv_usec');
    }
    /**
     * @param 'ru_stime.tv_sec'|'ru_utime.tv_sec'   $secondsKey
     * @param 'ru_stime.tv_usec'|'ru_utime.tv_usec' $microsecondsKey
     *
     * @throws RuntimeException
     */
    private function cpuTime(string $secondsKey, string $microsecondsKey): \PHPUnit\Event\Telemetry\CpuTime
    {
        $usage = getrusage();
        if ($usage === \false) {
            // @codeCoverageIgnoreStart
            throw new RuntimeException('getrusage() failed.');
            // @codeCoverageIgnoreEnd
        }
        if (!isset($usage[$secondsKey]) || !isset($usage[$microsecondsKey])) {
            // @codeCoverageIgnoreStart
            throw new RuntimeException(sprintf('getrusage() did not return the expected keys "%s" and "%s".', $secondsKey, $microsecondsKey));
            // @codeCoverageIgnoreEnd
        }
        $seconds = $usage[$secondsKey];
        $microseconds = $usage[$microsecondsKey];
        if (!is_int($seconds) || !is_int($microseconds)) {
            // @codeCoverageIgnoreStart
            throw new RuntimeException(sprintf('getrusage() returned non-integer values for "%s" and/or "%s".', $secondsKey, $microsecondsKey));
            // @codeCoverageIgnoreEnd
        }
        return \PHPUnit\Event\Telemetry\CpuTime::fromSecondsAndNanoseconds($seconds, $microseconds * 1000);
    }
}
