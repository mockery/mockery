                case 'large':
                    $result[] = Metadata::groupOnMethod('large');
                    break;
                case 'medium':
                    $result[] = Metadata::groupOnMethod('medium');
                    break;
                case 'postCondition':
                    $result[] = Metadata::postCondition();
