    {
        if ($value === null) {
            return 0;
        }
        if (is_bool($value)) {
            return 1;
        }
        if (is_int($value) || is_float($value)) {
            return 2;
        }
        if (is_string($value)) {
            return 3;
        }
        if (is_array($value)) {
            return 4;
        }
        if (is_object($value)) {
            return 5;
        }
