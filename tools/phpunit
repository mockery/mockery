        $writer = new XMLWriter();
        $writer->openUri($this->targetFilePath('index'));
        $writer->setIndent(\true);
        $writer->setIndentString('  ');
        $this->project = new Project($writer, $report->name());
        $this->setBuildInformation($runtime, $buildDate, $phpUnitVersion, $coverageVersion, $driverExtensionName, $driverExtensionVersion);
        $this->project->startProject();
