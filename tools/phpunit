            $line = $method->getStartLine();
            assert($file !== \false && $file !== '');
            assert($line !== \false);
            Event\Facade::emitter()->testTriggeredPhpunitError(new TestMethod($className, $methodName, $file, $line, Event\Code\TestDoxBuilder::fromClassNameAndMethodName($className, $methodName), MetadataCollection::fromArray([]), Event\TestData\TestDataCollection::fromArray([])), $message);
