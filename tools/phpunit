                    $x = $vb[$offset + $k + 1];
                } else {
                    /** @phpstan-ignore offsetAccess.notFound */
                    $x = $vb[$offset + $k - 1] + 1;
                }
                $y = $x - $k;
                $xs = $x;
                $ys = $y;
                /** @phpstan-ignore offsetAccess.notFound, offsetAccess.notFound */
                while ($x < $n && $y < $m && $a[$aLo + $n - 1 - $x] === $b[$bLo + $m - 1 - $y]) {
                    $x++;
                    $y++;
                }
                $vb[$offset + $k] = $x;
                if (!$deltaIsOdd) {
                    $kf = $delta - $k;
                    /** @phpstan-ignore offsetAccess.notFound */
                    if ($kf >= -$d && $kf <= $d && $vf[$offset + $kf] + $vb[$offset + $k] >= $n) {
                        return [$n - $x, $m - $y, $n - $xs, $m - $ys];
