                if ($deltaIsOdd) {
                    $kb = $delta - $k;
                    /** @phpstan-ignore offsetAccess.notFound */
                    if ($kb >= -($d - 1) && $kb <= $d - 1 && $vf[$offset + $k] + $vb[$offset + $kb] >= $n) {
