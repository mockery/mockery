        $existingTargets = array_map(static fn(\PHPUnit\Framework\ExecutionOrderDependency $dependency) => $dependency->getTarget(), $existing);
        foreach ($additional as $dependency) {
            $additionalTarget = $dependency->getTarget();
            if (in_array($additionalTarget, $existingTargets, \true)) {
