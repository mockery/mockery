    private function ensureVersionStringIsValid($version): void
    {
        $regex = '/^v?
            (?P<Major>0|[1-9]\d*)
            \.
            (?P<Minor>0|[1-9]\d*)
            (\.
                (?P<Patch>0|[1-9]\d*)
            )?
            (?:
                -
                (?<PreReleaseSuffix>(?:(dev|beta|b|rc|alpha|a|patch|p|pl)\.?\d*))
            )?
            (?:
                \+
                (?P<BuildMetadata>[0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-@]+)*)
            )?
