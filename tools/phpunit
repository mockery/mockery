            if ($diffEntry[1] === Differ::ADDED) {
                /** @phpstan-ignore binaryOp.invalid */
                fwrite($buffer, '+' . $diffEntry[0]);
            } elseif ($diffEntry[1] === Differ::REMOVED) {
                /** @phpstan-ignore binaryOp.invalid */
                fwrite($buffer, '-' . $diffEntry[0]);
            } elseif ($diffEntry[1] === Differ::DIFF_LINE_END_WARNING) {
                /** @phpstan-ignore binaryOp.invalid */
                fwrite($buffer, ' ' . $diffEntry[0]);
