                new OtrXmlLogger(EventFacade::instance(), $configuration->logfileOtr(), $configuration->includeGitInformationInOtrLogfile(), $configuration->executionOrder() === TestSuiteSorter::ORDER_RANDOMIZED ? $configuration->randomOrderSeed() : null);
