        if ($this->time === null) {
            $this->time = $event->telemetryInfo()->time();
        }
        $this->writeMessage('testFailed', ['name' => $event->test()->name(), 'message' => $this->message($event->throwable()), 'details' => $this->details($event->throwable()), 'duration' => $this->duration($event)]);
