    {
        $unintentionallyCoveredUnits = array_unique($unintentionallyCoveredUnits);
        $processed = [];
        foreach ($unintentionallyCoveredUnits as $unintentionallyCoveredUnit) {
            $tmp = explode('::', $unintentionallyCoveredUnit);
